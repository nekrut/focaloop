<tool id="focaloop_query" name="Focaloop Query warm-state instant contrast and sub-cohort comparison" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>zero-network-byte follow-up contrast or sub-cohort F_ST guarded by HypothesisLedger</description>
    <macros>
        <token name="@TOOL_VERSION@">0.2.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">focaloop</requirement>
        <container type="docker">ghcr.io/galaxyproject/focaloop:@TOOL_VERSION@</container>
    </requirements>
    <version_command>focaloop --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
focaloop query
    --state-dir '$state'
    --contrast '$contrast'
    --actor '$actor'
    #if str($hypothesis).strip()
        --hypothesis '$hypothesis'
    #end if
    #if str($design).strip()
        --design '$design'
    #end if
    --mode '$mode'
    --out-table '$query_table'
    --out-verdict '$verdict'
    --out-report '$query_report'
    --out-state-archive '$state_out'
    ]]></command>
    <inputs>
        <param name="state" type="data" format="data" label="Saved Focaloop state (.focaloop.tar.zst)"/>
        <param name="contrast" type="text" value="condition:treated:control" label="Contrast or sub-cohort comparison" help="e.g. condition:AR0387:AR0382 or Population:AS-SE-E:AF-W">
            <validator type="regex" message="Use A:B, factor:A:B, or factor=A:B">([A-Za-z0-9_]+[:=])?[A-Za-z0-9_,.-]+:[A-Za-z0-9_,.-]+</validator>
        </param>
        <param name="actor" type="text" value="human" label="Actor recorded in HypothesisLedger">
            <validator type="regex" message="Use 'human' or 'agent:name'">(human|agent:[A-Za-z0-9_.-]+)</validator>
        </param>
        <param name="hypothesis" type="text" value="" label="Specific gene / group to test (optional)">
            <validator type="regex" message="Letters, digits, '_', ':', '.', '-', '=' only">[A-Za-z0-9_:.=-]*</validator>
        </param>
        <param name="design" type="text" value="" label="Optional Wilkinson formula override (PanExpr)">
            <validator type="regex" message="Formula characters only">[A-Za-z0-9_ +~:*()-]*</validator>
        </param>
        <param name="mode" type="select" label="Query mode">
            <option value="auto" selected="true">Auto-detect from saved state</option>
            <option value="contrast">Differential expression contrast</option>
            <option value="fst">Sub-cohort F_ST and prevalence</option>
        </param>
    </inputs>
    <outputs>
        <data name="query_table" format="tabular" label="${tool.name} on ${on_string}: query_table.tsv"/>
        <data name="verdict" format="json" label="${tool.name} on ${on_string}: verdict.json"/>
        <data name="query_report" format="html" label="${tool.name} on ${on_string}: query_report.html"/>
        <data name="state_out" format="data" label="${tool.name} on ${on_string}: updated state (.focaloop.tar.zst)"/>
    </outputs>
    <tests>
        <test expect_num_outputs="4">
            <param name="state" value="panexpr_state.tar.zst" ftype="data"/>
            <param name="contrast" value="treated:control"/>
            <param name="actor" value="agent:planemo"/>
            <output name="query_table">
                <assert_contents>
                    <has_text text="g2"/>
                </assert_contents>
            </output>
            <output name="verdict">
                <assert_contents>
                    <has_text text="&quot;new_bytes&quot;: 0"/>
                </assert_contents>
            </output>
            <output name="query_report">
                <assert_contents>
                    <has_text text="0 B"/>
                </assert_contents>
            </output>
            <output name="state_out">
                <assert_contents>
                    <has_size min="1000"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="4">
            <param name="state" value="malariavar_state.tar.zst" ftype="data"/>
            <param name="contrast" value="site=Ghana:Mali"/>
            <param name="actor" value="human"/>
            <param name="mode" value="fst"/>
            <output name="query_table">
                <assert_contents>
                    <has_text text="hudson_fst"/>
                </assert_contents>
            </output>
            <output name="verdict">
                <assert_contents>
                    <has_text text="&quot;mode&quot;: &quot;fst&quot;"/>
                </assert_contents>
            </output>
            <output name="query_report">
                <assert_contents>
                    <has_text text="0 B"/>
                </assert_contents>
            </output>
            <output name="state_out">
                <assert_contents>
                    <has_size min="1000"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Executes a zero-network-byte follow-up contrast (`PanExpr`) or sub-cohort WHO resistance & Hudson $F_{ST}$
comparison (`MalariaVar`) against a saved `.focaloop.tar.zst` warm state bundle, charging alpha-wealth in
the persisted `HypothesisLedger`.
    ]]></help>
    <citations>
        <citation type="doi">10.1126/science.aaa9375</citation>
    </citations>
</tool>
