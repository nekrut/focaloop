<tool id="focaloop_query" name="Focaloop warm-state contrast and F_ST query" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>zero-new-byte follow-up verified on the reusable holdout</description>
    <macros>
        <token name="@TOOL_VERSION@">0.1.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">focaloop</requirement>
        <container type="docker">ghcr.io/galaxyproject/focaloop:@TOOL_VERSION@</container>
    </requirements>
    <version_command>focaloop --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
focaloop query
    --state-dir '$state'
    --contrast '$contrast'
    --actor '$actor'
    #if str($hypothesis).strip()
        --hypothesis '$hypothesis'
    #end if
    --mode '$mode'
    --out-table '$query_table'
    --out-verdict '$verdict'
    --out-state-archive '$state_out'
    ]]></command>
    <inputs>
        <param name="state" type="data" format="data" label="Focaloop warm state (.tar.zst)"/>
        <param name="contrast" type="text" value="treated:control" label="Contrast" help="A:B on the condition column, or field=A:B (e.g. site=Ghana:Mali)">
            <validator type="regex" message="Use A:B or field=A:B">([A-Za-z0-9_]+=)?[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+</validator>
        </param>
        <param name="actor" type="text" value="human" label="Actor recorded in the hypothesis ledger">
            <validator type="regex" message="Use 'human' or 'agent:name'">(human|agent:[A-Za-z0-9_.-]+)</validator>
        </param>
        <param name="hypothesis" type="text" value="" label="Group to test" help="Leave empty to test the top discovery hit">
            <validator type="regex" message="Letters, digits, '_', '.', '-', '=' only">[A-Za-z0-9_.=-]*</validator>
        </param>
        <param name="mode" type="select" label="Query mode">
            <option value="auto" selected="true">Auto (F_ST when allele counts exist)</option>
            <option value="contrast">Contrast</option>
            <option value="fst">F_ST</option>
        </param>
    </inputs>
    <outputs>
        <data name="query_table" format="tabular" label="${tool.name} on ${on_string}: table"/>
        <data name="verdict" format="json" label="${tool.name} on ${on_string}: verdict"/>
        <data name="state_out" format="data" label="${tool.name} on ${on_string}: state with ledger entry"/>
    </outputs>
    <tests>
        <test expect_num_outputs="3">
            <param name="state" value="panexpr_state.tar.zst" ftype="data"/>
            <param name="contrast" value="treated:control"/>
            <param name="actor" value="agent:planemo"/>
            <output name="query_table">
                <assert_contents>
                    <has_text text="log2fc_holdout"/>
                    <has_text text="g2"/>
                </assert_contents>
            </output>
            <output name="verdict">
                <assert_contents>
                    <has_text text="&quot;new_bytes&quot;: 0"/>
                    <has_text text="&quot;confirmed&quot;: true"/>
                </assert_contents>
            </output>
            <output name="state_out">
                <assert_contents>
                    <has_size min="1000"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="3">
            <param name="state" value="malariavar_state.tar.zst" ftype="data"/>
            <param name="contrast" value="site=Ghana:Mali"/>
            <param name="actor" value="human"/>
            <param name="mode" value="fst"/>
            <output name="query_table">
                <assert_contents>
                    <has_text text="hudson_fst"/>
                </assert_contents>
            </output>
            <output name="verdict">
                <assert_contents>
                    <has_text text="&quot;mode&quot;: &quot;fst&quot;"/>
                </assert_contents>
            </output>
            <output name="state_out">
                <assert_contents>
                    <has_size min="1000"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Answers a follow-up question against a saved focaloop state without streaming new bytes.
*Contrast* mode estimates group-level log2 fold changes on the discovery partition, re-tests the chosen
group on the holdout partition, and charges the query against the HypothesisLedger alpha-wealth
(online alpha-investing). *F_ST* mode computes Hudson F_ST between two sample groups from saved allele
counts, with a label-permutation p-value, on both partitions.

-----

**Outputs**

- *Table*: discovery and holdout estimates.
- *Verdict*: JSON with `confirmed`, alpha allocated, remaining wealth and `new_bytes: 0`.
- *State with ledger entry*: chain it into the next query so alpha-wealth carries over.
    ]]></help>
    <citations>
        <citation type="doi">10.1126/science.aaa9375</citation>
    </citations>
</tool>
