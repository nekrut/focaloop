<tool id="focaloop_panexpr" name="Focaloop PanExpr RNA-seq differential expression loop" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>adaptive SRA/ENA streaming DE with aligner tournament, multi-reference EM and 31-mer zoom</description>
    <macros>
        <token name="@TOOL_VERSION@">0.2.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">focaloop</requirement>
        <container type="docker">ghcr.io/galaxyproject/focaloop:@TOOL_VERSION@</container>
    </requirements>
    <version_command>focaloop --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
focaloop panexpr
    --manifest '$manifest'
    --ref-fasta '$ref_fasta'
    --ref-gtf '$ref_gtf'
    #if $secondary_fasta
        --secondary-fasta '$secondary_fasta'
    #end if
    #if $secondary_gtf
        --secondary-gtf '$secondary_gtf'
    #end if
    --primary-label '$primary_label'
    --secondary-label '$secondary_label'
    #if $reads
        --reads
        #for $r in $reads
            '$r'
        #end for
        --read-ids
        #for $r in $reads
            '$r.element_identifier'
        #end for
    #end if
    --contrast '$contrast'
    --organism-mode '$organism_mode'
    --source-mode '$source_mode'
    --max-byte-fraction $max_byte_fraction
    --v-tech-target $v_tech_target
    #if not $enable_zoom
        --no-zoom
    #end if
    --threads \${GALAXY_SLOTS:-8}
    --state-dir panexpr_state_dir
    --state-archive '$panexpr_state'
    --out-de '$de_results'
    --out-report '$focaloop_report'
    ]]></command>
    <inputs>
        <param name="manifest" type="data" format="tabular" label="Sample manifest (TSV)" help="Columns: sample_id, condition, run_or_url (SRR/ERR accession, HTTPS URL, or History dataset name)"/>
        <param name="ref_fasta" type="data" format="fasta,fasta.gz" label="Reference genome FASTA"/>
        <param name="ref_gtf" type="data" format="gtf,gff,gff3" label="Reference annotation (GTF / GFF3)"/>
        <param name="secondary_fasta" type="data" format="fasta,fasta.gz" optional="true" label="Secondary strain / release / virus FASTA (optional)"/>
        <param name="secondary_gtf" type="data" format="gtf,gff,gff3" optional="true" label="Secondary annotation GTF / GFF3 (optional)"/>
        <param name="primary_label" type="text" value="primary" label="Primary assembly label">
            <validator type="regex" message="Letters, digits, '_', '.', '-' only">[A-Za-z0-9_.-]+</validator>
        </param>
        <param name="secondary_label" type="text" value="secondary" label="Secondary assembly label">
            <validator type="regex" message="Letters, digits, '_', '.', '-' only">[A-Za-z0-9_.-]+</validator>
        </param>
        <param name="reads" type="data" format="fastqsanger,fastqsanger.gz" multiple="true" optional="true" label="Optional History FASTQ datasets"/>
        <param name="contrast" type="text" value="condition:treated:control" label="Primary contrast (factor:treated:control)">
            <validator type="regex" message="Use factor:A:B or A:B">([A-Za-z0-9_]+[:=])?[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+</validator>
        </param>
        <param name="organism_mode" type="select" label="Organism splicing regime">
            <option value="auto" selected="true">Auto-detect from GTF/GFF3</option>
            <option value="eukaryotic">Eukaryotic (spliced cDNA + decoys)</option>
            <option value="prokaryotic">Prokaryotic / compact CDS</option>
        </param>
        <param name="source_mode" type="select" label="Archive streaming transport">
            <option value="auto" selected="true">Auto (History FASTQ or ENA HTTPS 206)</option>
            <option value="http_range">ENA HTTPS 206 byte-range</option>
            <option value="sra_odp">AWS SRA Open Data spot blocks (xsra)</option>
            <option value="local_bytes">Local History FASTQ bytes</option>
        </param>
        <param name="max_byte_fraction" type="float" min="0.005" max="1.0" value="0.12" label="Max archive byte fraction (0.12 = 12%)"/>
        <param name="v_tech_target" type="float" min="0.02" max="0.9" value="0.25" label="Stopping threshold on median V_tech / (V_tech + V_bio)"/>
        <param name="enable_zoom" type="boolean" checked="true" label="Enable Stage-5 31-mer borderline zoom"/>
    </inputs>
    <outputs>
        <data name="de_results" format="tabular" label="${tool.name} on ${on_string}: de_results.tsv"/>
        <data name="focaloop_report" format="html" label="${tool.name} on ${on_string}: focaloop_report.html"/>
        <data name="panexpr_state" format="data" label="${tool.name} on ${on_string}: panexpr_state.focaloop.tar.zst"/>
    </outputs>
    <tests>
        <test expect_num_outputs="3">
            <param name="manifest" value="manifest_local.tsv"/>
            <param name="ref_fasta" value="targets.fa"/>
            <param name="ref_gtf" value="ref_genes.gtf"/>
            <param name="reads" value="ctrl1.fastq.gz,ctrl2.fastq.gz,ctrl3.fastq.gz,trt1.fastq.gz,trt2.fastq.gz,trt3.fastq.gz" ftype="fastqsanger.gz"/>
            <param name="contrast" value="condition:treated:control"/>
            <param name="max_byte_fraction" value="1.0"/>
            <output name="de_results">
                <assert_contents>
                    <has_text text="log2FoldChange"/>
                </assert_contents>
            </output>
            <output name="focaloop_report">
                <assert_contents>
                    <has_text text="Focaloop PanExpr"/>
                </assert_contents>
            </output>
            <output name="panexpr_state">
                <assert_contents>
                    <has_size min="500"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Runs the 5-stage **Focaloop PanExpr** differential expression loop directly against SRA/ENA accessions
(streamed via HTTPS `Range` or `xsra`) or Galaxy History FASTQ datasets, emitting `de_results.tsv`,
a self-contained `focaloop_report.html`, and a compact `panexpr_state.focaloop.tar.zst` warm state bundle
for zero-byte follow-up contrasts in **Focaloop Query**.
    ]]></help>
    <citations>
        <citation type="doi">10.1038/nmeth.4197</citation>
    </citations>
</tool>
