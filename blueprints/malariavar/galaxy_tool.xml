<tool id="focaloop_malariavar" name="Focaloop MalariaVar Plasmodium variation and drug-resistance loop" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>focused .crai CRAM range surveillance and host-sieved SRA streaming for WHO DRMs, CNVs, hrp2/3 and F_WS</description>
    <macros>
        <token name="@TOOL_VERSION@">0.2.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">focaloop</requirement>
        <container type="docker">ghcr.io/galaxyproject/focaloop:@TOOL_VERSION@</container>
    </requirements>
    <version_command>focaloop --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
focaloop malariavar
    --manifest '$manifest'
    #if $ref_fasta
        --ref-fasta '$ref_fasta'
    #end if
    --mode '$mode'
    --target-depth $target_depth
    --mapper '$mapper'
    --threads \${GALAXY_SLOTS:-8}
    --state-dir malariavar_state_dir
    --state-archive '$malariavar_state'
    --out-drm '$drm_calls'
    --out-variants '$variants_summary'
    --out-report '$malariavar_report'
    ]]></command>
    <inputs>
        <param name="manifest" type="data" format="tabular" label="Isolate manifest (TSV)" help="Columns: sample_id, country_or_group, source_uri_or_srr[, crai_uri_optional, population, sample_type]"/>
        <param name="ref_fasta" type="data" format="fasta,fasta.gz" optional="true" label="Pf3D7 reference FASTA (optional; uses bundled Pf3D7 if omitted)"/>
        <param name="mode" type="select" label="Surveillance streaming mode">
            <option value="auto" selected="true">Auto-detect per isolate (.cram vs ERR/SRR)</option>
            <option value="focused_cram">Mode A: Focused .crai CRAM HTTP Range surveillance</option>
            <option value="wgs_stream">Mode B: Raw SRA/FASTQ streaming + C host sieve</option>
        </param>
        <param name="target_depth" type="float" min="5.0" max="100.0" value="24.0" label="Target median core depth (Mode B stop gate)"/>
        <param name="mapper" type="select" label="Short-read aligner (Mode B)">
            <option value="auto" selected="true">Auto (probe-verified strobealign / minimap2 / bwa-mem2)</option>
            <option value="strobealign">strobealign</option>
            <option value="minimap2">minimap2</option>
            <option value="bwa-mem2">bwa-mem2</option>
        </param>
    </inputs>
    <outputs>
        <data name="drm_calls" format="tabular" label="${tool.name} on ${on_string}: drm_calls.tsv"/>
        <data name="variants_summary" format="tabular" label="${tool.name} on ${on_string}: variants_summary.tsv"/>
        <data name="malariavar_report" format="html" label="${tool.name} on ${on_string}: malariavar_report.html"/>
        <data name="malariavar_state" format="data" label="${tool.name} on ${on_string}: malariavar_state.focaloop.tar.zst"/>
    </outputs>
    <tests>
        <test expect_num_outputs="4">
            <param name="manifest" value="manifest_pf8.tsv"/>
            <param name="ref_fasta" value="targets.fa"/>
            <param name="mode" value="focused_cram"/>
            <output name="drm_calls">
                <assert_contents>
                    <has_text text="who_artemisinin"/>
                </assert_contents>
            </output>
            <output name="variants_summary">
                <assert_contents>
                    <has_text text="sample_id"/>
                </assert_contents>
            </output>
            <output name="malariavar_report">
                <assert_contents>
                    <has_text text="Focaloop MalariaVar"/>
                </assert_contents>
            </output>
            <output name="malariavar_state">
                <assert_contents>
                    <has_size min="500"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

Runs **Focaloop MalariaVar** in either focused `.crai` CRAM HTTP Range surveillance mode (55 curated drug-resistance,
CNV, *hrp2/3* deletion, and core barcode windows) or raw SRA/ENA streaming mode with an inline C 31-mer / PLA human
host-depletion sieve and adaptive depth stop gate.
    ]]></help>
    <citations>
        <citation type="doi">10.12688/wellcomeopenres.18681.1</citation>
    </citations>
</tool>
