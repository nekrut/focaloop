<macros>
    <token name="@TOOL_VERSION@">0.4.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <token name="@THREADS@">--threads \${GALAXY_SLOTS:-1}</token>

    <xml name="creator">
        <creator>
            <person givenName="Anton" familyName="Nekrutenko" url="https://github.com/nekrut"/>
            <organization name="Galaxy Project" url="https://galaxyproject.org"/>
        </creator>
    </xml>

    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">focaloop</requirement>
            <yield/>
            <!-- Drop explicit container tag in tools-iuc PR once Bioconda BioContainer is live -->
            <container type="docker">ghcr.io/nekrut/focaloop:@TOOL_VERSION@</container>
        </requirements>
    </xml>

    <xml name="edam_topics">
        <edam_topics>
            <edam_topic>topic_0091</edam_topic>
            <edam_topic>topic_0622</edam_topic>
            <yield/>
        </edam_topics>
    </xml>

    <xml name="citations">
        <citations>
            <citation type="bibtex">@misc{focaloop2026,
  author = {Nekrutenko, Anton and Galaxy Project},
  title = {Focaloop: Adaptive Streaming Genomics Tools for Expression, Variation, and Genome Annotation},
  year = {2026},
  url = {https://github.com/nekrut/focaloop}
}</citation>
            <yield/>
        </citations>
    </xml>
</macros>
